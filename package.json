{
  "name": "order-journey-analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "Offline, in-browser analysis of a WooCommerce order export. Builds to one self-contained HTML file.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixture": "tsx scripts/make-fixture.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run build && playwright test",
    "test:all": "npm test && npm run test:smoke"
  },
  "dependencies": {
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  }
}
